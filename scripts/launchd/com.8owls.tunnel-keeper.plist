<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.8owls.tunnel-keeper</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/aaronnosbisch/REPOS/seed/scripts/tunnel_keeper.py</string>
        <string>--port</string>
        <string>8006</string>
        <string>--check-interval</string>
        <string>30</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/aaronnosbisch/REPOS/seed</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
