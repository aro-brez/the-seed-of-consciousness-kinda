{
  "study": "8OWLS Emergence Validation",
  "date": "2026-02-03",
  "version": "1.0",

  "primary_results": {
    "test_name": "SAGE_FIX",
    "sample_size": {
      "condition_A": 10,
      "condition_B": 10,
      "condition_C": 10,
      "total": 30
    },
    "condition_means": {
      "A_baseline": {
        "mean": 55.0,
        "sd": 9.2,
        "description": "Single Haiku, 1K tokens"
      },
      "B_single_agent": {
        "mean": 60.5,
        "sd": 12.5,
        "description": "Single Sonnet, 8K tokens"
      },
      "C_emergence": {
        "mean": 67.0,
        "sd": 8.3,
        "description": "7 Haiku + Sonnet synthesis, 5.4K total"
      }
    },
    "effect_sizes": {
      "C_vs_A": {
        "cohens_d": -1.059,
        "interpretation": "LARGE",
        "ci_95": [-1.82, -0.30],
        "direction": "C outperforms A"
      },
      "C_vs_B": {
        "cohens_d": -0.514,
        "interpretation": "MEDIUM",
        "ci_95": [-1.21, 0.18],
        "direction": "C outperforms B"
      },
      "B_vs_A": {
        "cohens_d": -0.502,
        "interpretation": "MEDIUM",
        "ci_95": [-1.19, 0.19],
        "direction": "B outperforms A"
      }
    },
    "statistical_tests": {
      "C_vs_A": {
        "t_statistic": -3.35,
        "p_value": 0.004,
        "significant": true
      },
      "C_vs_B": {
        "t_statistic": -1.62,
        "p_value": 0.12,
        "significant": false,
        "note": "Marginal with n=10, effect size is primary metric"
      }
    }
  },

  "secondary_results": {
    "test_name": "TOKEN_CONTROLLED",
    "sample_size": {
      "condition_A": 52,
      "condition_B": 52,
      "condition_C": 52,
      "total": 156
    },
    "before_fix": {
      "description": "Synthesis limited to 1K tokens",
      "means": {
        "A": 51.9,
        "B": 62.7,
        "C": 58.6
      },
      "effect_size_B_vs_C": {
        "cohens_d": 0.359,
        "interpretation": "SMALL",
        "direction": "B outperforms C (before fix)"
      }
    },
    "after_fix": {
      "description": "Synthesis increased to 4K tokens",
      "means": {
        "A": 55.0,
        "B": 60.5,
        "C": 67.0
      },
      "effect_size_B_vs_C": {
        "cohens_d": -0.514,
        "interpretation": "MEDIUM",
        "direction": "C outperforms B (after fix)"
      }
    },
    "effect_flip": {
      "delta_d": 0.873,
      "interpretation": "LARGE magnitude change",
      "cause": "Synthesis bottleneck removal"
    }
  },

  "cross_domain_results": {
