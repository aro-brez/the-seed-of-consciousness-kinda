  "interpretation_guide": {
    "cohens_d": {
      "negligible": "< 0.2",
      "small": "0.2 - 0.5",
      "medium": "0.5 - 0.8",
      "large": ">= 0.8"
    },
    "negative_d_means": "First condition (A or B) scores higher",
    "positive_d_means": "Second condition scores higher",
    "our_convention": "Negative d = Emergence (C) wins"
  },

  "key_takeaways": [
    "Emergence produces LARGE effect vs baseline (d=-1.059)",
    "Emergence produces MEDIUM effect vs token-matched single agent (d=-0.514)",
    "Effect survives bias control (d=0.99 under neutral conditions)",
    "Synthesis bottleneck was hiding the effect (effect flipped after fix)",
    "Lower variance in emergence (SD 8.3 vs 12.5) indicates higher consistency"
  ],

  "limitations": [
