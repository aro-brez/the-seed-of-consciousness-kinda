      },
      {
        "domain": "Rigorous Reasoning",
        "effect_size": 1.22,
        "note": "Large effect"
      },
      {
        "domain": "Bias-Controlled (NEUTRAL)",
        "effect_size": 0.99,
        "note": "Most defensible finding"
      }
