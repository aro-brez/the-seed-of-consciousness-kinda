{
  "name": "seed-interface",
  "version": "1.0.0",
  "description": "Low-latency always-on communication interface for THE SEED",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "tsx src/db/init.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "test:sms": "tsx src/scripts/test-sms.ts",
    "outreach": "tsx src/scripts/run-outreach.ts"
  },
  "dependencies": {
    "twilio": "^5.0.0",
    "express": "^4.18.2",
    "openai": "^4.28.0",
    "@anthropic-ai/sdk": "^0.20.0",
    "better-sqlite3": "^9.4.3",
    "dotenv": "^16.4.1",
    "uuid": "^9.0.1",
    "node-cron": "^3.0.3",
    "multer": "^1.4.5-lts.1",
    "axios": "^1.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@types/express": "^4.17.21",
    "@types/better-sqlite3": "^7.6.9",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^9.0.8",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.3.3",
