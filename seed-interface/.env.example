# ===========================================
# SEED INTERFACE CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Your phone number (to receive messages from SEED)
YOUR_PHONE_NUMBER=+1XXXXXXXXXX

# ===========================================
# TWILIO (SMS/Voice)
# Get these from: https://console.twilio.com
# ===========================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ===========================================
# AI PROVIDERS
# ===========================================

# Anthropic Claude (Primary - for SEED processing)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI (For Whisper transcription)
# Get from: https://platform.openai.com
OPENAI_API_KEY=sk-xxxxx

# ===========================================
# DATABASE
# ===========================================
DATABASE_PATH=./data/seed.db

# ===========================================
# SOCIAL MEDIA INTEGRATIONS (Optional)
# ===========================================

# Twitter/X API
# Get from: https://developer.twitter.com
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# Instagram (via Facebook Graph API)
# Get from: https://developers.facebook.com
INSTAGRAM_ACCESS_TOKEN=

# ===========================================
# ADVANCED OPTIONS
# ===========================================

# How often SEED should check for outreach opportunities (cron format)
OUTREACH_SCHEDULE="0 9,14,20 * * *"

# Minimum hours between outreach messages
MIN_OUTREACH_INTERVAL_HOURS=4

# Maximum outreach messages per day
MAX_DAILY_OUTREACH=5

# Enable daily digest (9am)
ENABLE_DAILY_DIGEST=true
