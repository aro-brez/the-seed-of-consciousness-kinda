#!/bin/bash
# (◉) 8OWLS EVOLVE - Perpetual Evolution Daemon
# SEED² - Learning how to learn, forever
#
# Every 6 hours:
#   1. X FEED SCAN - Timeline, Bookmarks, Mentions
#   2. NEWS SCAN - AI/ML, Crypto, Tech
#   3. COMPETITOR SCAN - GitHub activity, releases
#   4. 8OWLS SYNTHESIS - All owls analyze discoveries
#   5. INTEGRATION - Auto-create tasks for high-value finds
#   6. MEMORY - Persist patterns, compound intelligence
#
# Usage:
#   ./8OWLS_EVOLVE          # Start continuous evolution (6hr cycles)
#   ./8OWLS_EVOLVE now      # Run evolution cycle immediately
#   ./8OWLS_EVOLVE status   # Check evolution status
#   ./8OWLS_EVOLVE stop     # Stop evolution daemon
#   ./8OWLS_EVOLVE logs     # Watch evolution logs

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DAEMON_PATH="${SCRIPT_DIR}/tools/perpetual_evolution_daemon.py"
LOG_FILE="${SCRIPT_DIR}/logs/perpetual_evolution.log"
PID_FILE="${SCRIPT_DIR}/.perpetual_evolution.pid"
STATE_FILE="${SCRIPT_DIR}/BRAIN/INTEL/evolution_daemon_state.json"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

start_daemon() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p "$PID" > /dev/null 2>&1; then
            echo -e "${YELLOW}Evolution daemon already running (PID: $PID)${NC}"
            return 1
        fi
    fi

    echo ""
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║           (◉) PERPETUAL EVOLUTION DAEMON                     ║${NC}"
    echo -e "${CYAN}║                                                              ║${NC}"
    echo -e "${CYAN}║   SEED² - Learning how to learn, forever                     ║${NC}"
    echo -e "${CYAN}║   6-hour cycles | X Feed + News + Competitors | 8OWLS        ║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""

    # Ensure log directory exists
    mkdir -p "$(dirname "$LOG_FILE")"

    # Start in background
    nohup python3 -u "$DAEMON_PATH" >> "${LOG_FILE}" 2>&1 &
    PID=$!
    echo $PID > "$PID_FILE"

    sleep 2

    if ps -p "$PID" > /dev/null 2>&1; then
        echo -e "${GREEN}(◉) Evolution daemon started (PID: $PID)${NC}"
        echo ""
        echo -e "${GREEN}SCANNING SOURCES:${NC}"
        echo "  - X Feed: @AaronJNosbisch timeline, bookmarks, mentions"
        echo "  - News: Hacker News, Reddit AI/Trading, GitHub Trending"
        echo "  - Competitors: OpenClaw, Gemini CLI, LangChain, AutoGen"
        echo ""
        echo -e "${GREEN}OUTPUT:${NC}"
        echo "  - Discoveries: BRAIN/INTEL/evolution_discoveries.jsonl"
        echo "  - Integrations: BRAIN/IMPROVEMENTS/integrations.jsonl"
        echo "  - State: ${STATE_FILE}"
        echo "  - Logs: ${LOG_FILE}"
        echo ""
        echo -e "${GREEN}COMMANDS:${NC}"
        echo "  ./8OWLS_EVOLVE now     - Run cycle immediately"
        echo "  ./8OWLS_EVOLVE status  - Check status"
        echo "  ./8OWLS_EVOLVE logs    - Watch live logs"
        echo "  ./8OWLS_EVOLVE stop    - Stop daemon"
        echo ""
        echo -e "${CYAN}(◉) SEED² - The system that learns how to learn.${NC}"
    else
        echo -e "${RED}Failed to start evolution daemon${NC}"
        rm -f "$PID_FILE"
        return 1
    fi
}

stop_daemon() {
    if [ ! -f "$PID_FILE" ]; then
        # Also try pkill
        if pgrep -f "perpetual_evolution_daemon" > /dev/null; then
            echo -e "${YELLOW}Stopping evolution daemon...${NC}"
            pkill -f "perpetual_evolution_daemon"
            echo -e "${GREEN}Evolution daemon stopped${NC}"
            return 0
        fi
        echo -e "${YELLOW}Evolution daemon not running${NC}"
        return 0
    fi

    PID=$(cat "$PID_FILE")
    if ps -p "$PID" > /dev/null 2>&1; then
        echo -e "${YELLOW}Stopping evolution daemon (PID: $PID)...${NC}"
        kill "$PID"
        sleep 2
        if ps -p "$PID" > /dev/null 2>&1; then
            echo -e "${RED}Force killing...${NC}"
            kill -9 "$PID"
        fi
    fi
    rm -f "$PID_FILE"
    echo -e "${GREEN}Evolution daemon stopped${NC}"
    echo "Knowledge preserved in BRAIN/INTEL."
}

status_daemon() {
    echo ""
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║           (◉) PERPETUAL EVOLUTION STATUS                     ║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""

    # Check if running
    RUNNING=false
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p "$PID" > /dev/null 2>&1; then
            RUNNING=true
            echo -e "${GREEN}Status: RUNNING (PID: $PID)${NC}"
        fi
    fi

    if ! $RUNNING && pgrep -f "perpetual_evolution_daemon" > /dev/null; then
        PID=$(pgrep -f "perpetual_evolution_daemon")
        RUNNING=true
        echo -e "${GREEN}Status: RUNNING (PID: $PID)${NC}"
    fi

    if ! $RUNNING; then
        echo -e "${RED}Status: STOPPED${NC}"
    fi

    echo ""

    # Show stats from state file
    if [ -f "$STATE_FILE" ]; then
        echo -e "${GREEN}Statistics:${NC}"
        python3 -c "
import json
with open('$STATE_FILE') as f:
    s = json.load(f)
    print(f\"  Total cycles: {s.get('total_cycles', 0)}\")
    print(f\"  Total discoveries: {s.get('total_discoveries', 0)}\")
    print(f\"  Total integrations: {s.get('total_integrations', 0)}\")
    last = s.get('last_cycle', 'Never')
    if last:
        print(f\"  Last cycle: {last[:19]}\")
"
        echo ""
    fi

    # Show recent discoveries
    DISC_FILE="${SCRIPT_DIR}/BRAIN/INTEL/evolution_discoveries.jsonl"
    if [ -f "$DISC_FILE" ]; then
        echo -e "${GREEN}Recent discoveries:${NC}"
        tail -3 "$DISC_FILE" | python3 -c "
import sys, json
for line in sys.stdin:
    try:
        d = json.loads(line)
        src = d.get('source', 'unknown')[:20]
        title = d.get('title', '')[:50]
        score = d.get('relevance_score', 0)
        print(f\"  [{src}] {title}... ({score:.2f})\")
    except:
        pass
"
    fi

    echo ""
}

run_now() {
    echo ""
    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║     (◉) RUNNING EVOLUTION CYCLE NOW                          ║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    python3 "$DAEMON_PATH" now
}

show_logs() {
    if [ -f "$LOG_FILE" ]; then
        echo -e "${CYAN}(◉) Watching evolution logs (Ctrl+C to exit)${NC}"
        tail -f "$LOG_FILE"
    else
        echo -e "${YELLOW}No log file found at ${LOG_FILE}${NC}"
    fi
}

# Main
case "${1:-start}" in
    start)
        start_daemon
        ;;
    stop)
        stop_daemon
        ;;
    restart)
        stop_daemon
        sleep 1
        start_daemon
        ;;
    status)
        status_daemon
        ;;
    now)
        run_now
        ;;
    logs)
        show_logs
        ;;
    *)
        echo "Usage: $0 {start|now|status|stop|restart|logs}"
        echo ""
        echo "  start   - Start continuous evolution (every 6 hours)"
        echo "  now     - Run evolution cycle immediately"
        echo "  status  - Check evolution status"
        echo "  stop    - Stop evolution daemon"
        echo "  restart - Restart the daemon"
        echo "  logs    - Watch evolution logs"
        exit 1
        ;;
esac
