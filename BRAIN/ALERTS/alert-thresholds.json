  "escalation_rules": {
    "yellow_to_red": {
      "rule": "Two yellow alerts in same category within 5 minutes",
      "action": "Escalate to red immediately"
    },
    "yellow_persistence": {
      "rule": "Same yellow alert for >10 minutes AND condition worsening",
      "action": "Escalate to red"
    },
    "yellow_accumulation": {
      "rule": "3+ yellow alerts across different categories in 2 minutes",
      "action": "Escalate to red (system failure likely)"
    },
    "red_immediate": {
      "rule": "Any red alert triggers",
      "action": "STOP ALL TRADING immediately, publish alert, wait for human"
    }
  },
  "response_actions": {
    "yellow_alert": [
      "Log to overnight_alerts.jsonl",
      "Publish to NATS: nats_publish.py '[WARN] [category]: [issue]'",
      "Reduce position size by 20-25% (if market-related)",
      "Monitor more aggressively for 5 minutes",
      "Check if it resolves (if yes → resume normal) or worsens (if yes → escalate to red)"
    ],
    "red_alert": [
      "pkill -f autonomous_trader.py",
      "pkill -f autonomous_compounder.py",
      "Log full state: python3 tools/dump_state.py > logs/incident_[timestamp].log",
      "Publish critical alert: nats_publish.py '[CRITICAL] [category]: [issue]'",
      "DO NOT attempt automated recovery",
      "Wait for human (ARŌ or other instance) to make decision"
    ]
  },
  "monitoring_frequencies": {
    "every_10_seconds": "Flash crash detection, stale data checks",
    "every_30_seconds": "System resources (CPU, memory, temp), orderbook depth",
    "every_minute": "Network, orderbook imbalance, position count, price validation",
    "every_5_minutes": "API latency, disk space, DNS, anomaly signals, NATS status",
    "every_trade": "Execution latency, failed orders, strategy rules, whale tracking",
    "every_hour": "API key validity, status reports, win rate calculation",
    "continuous": "NATS connection state, market circuit breakers, credentials monitoring"
  },
  "thresholds_notes": {
    "spread_measurement": "Measured as (ask - bid) / mid_price * 100",
    "imbalance_measurement": "Measured as max_side / (max_side + min_side) * 100",
    "latency_measurement": "From request sent to response received, milliseconds",
    "price_movement": "Measured as (new_price - old_price) / old_price * 100",
    "win_rate_calculation": "Trades with positive P&L / Total trades",
    "flash_crash": "Price movement >30% in <10 seconds (indicates exchange issue)"
  },
